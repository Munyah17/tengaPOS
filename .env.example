# Supabase Configuration
# Get these from your Supabase project settings.
# NOTE: never put secret keys (service role, Stripe, Groq, ...) in VITE_*
# variables — anything prefixed VITE_ is bundled into public frontend code.
# Server-side keys belong in `supabase secrets` / edge function env only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
